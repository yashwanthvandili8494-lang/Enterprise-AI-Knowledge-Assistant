# ==============================================================================
# ENTERPRISE AI KNOWLEDGE ASSISTANT - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Instructions: Copy this file to '.env' and populate with your environment secrets.
# Do NOT commit '.env' containing production credentials to public repositories.

# --- APPLICATION SETTINGS ---
PROJECT_NAME="Enterprise AI Knowledge Assistant"
API_V1_STR="/api/v1"
LOG_LEVEL="INFO" # DEBUG, INFO, WARNING, ERROR

# --- DATABASE CONFIGURATION ---
# Production / Docker Compose (PostgreSQL with pgvector):
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/knowledge_db"
DATABASE_SYNC_URL="postgresql://postgres:postgres@localhost:5432/knowledge_db"

# Local Development / Zero-Dependency Testing (SQLite fallback):
# DATABASE_URL="sqlite+aiosqlite:///./knowledge_dev.db"
# DATABASE_SYNC_URL="sqlite:///./knowledge_dev.db"

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=knowledge_db

# --- SECURITY & AUTHENTICATION (JWT) ---
# Generate a secure 32+ byte random string for production:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY="enterprise-ai-super-secret-jwt-signing-key-for-development-change-in-prod-32bytes"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- ARTIFICIAL INTELLIGENCE & EMBEDDINGS PROVIDER ---
# Options: "gemini" (Google GenAI), "openai" (OpenAI API), or "mock" (offline/tests)
AI_PROVIDER="gemini"

# Google Gemini API Configuration (Recommended)
# Obtain key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""
LLM_MODEL="gemini-1.5-flash"
EMBEDDING_MODEL="text-embedding-004"
EMBEDDING_DIMENSIONS=768

# Optional OpenAI Fallback
OPENAI_API_KEY=""

# --- RAG RETRIEVAL & SEGMENTATION HYPERPARAMETERS ---
CHUNK_SIZE=800
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=5
SIMILARITY_THRESHOLD=0.25

# --- STORAGE CONFIGURATION ---
UPLOAD_DIRECTORY="./storage/uploads"
MAX_UPLOAD_SIZE_MB=25

# --- TASK QUEUE & REDIS ---
REDIS_URL="redis://localhost:6379/0"
USE_IN_PROCESS_WORKER=true

# --- CORS SETTINGS ---
# Comma-separated list of permitted origins
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://localhost:80,http://localhost"

# --- DEMO SEED DATA CREDENTIALS ---
DEMO_PASSWORD="DemoPass123!"
